export function getCart() {
  try {
    const cart = JSON.parse(localStorage.getItem('cart'));
    return Array.isArray(cart) ? cart : [];
  } catch (error) {
    return [];
  }
}

export function saveCart(cart) {
  localStorage.setItem('cart', JSON.stringify(cart));
}

export function updateCartBadge() {
  const cartCount = document.getElementById('cartCount');
  if (cartCount) {
    cartCount.textContent = getCart().length;
  }
}

export function addToCart(item) {
  const cart = getCart();
  cart.push({
    name: item.name,
    price: item.price
  });

  saveCart(cart);
  updateCartBadge();

  const { showToast } = await import('./toast.js');
  showToast(`✓ ${item.name} added to your cart!`);
}

export function clearCart() {
  saveCart([]);

  const cartItems = document.getElementById('cartItems');
  const cartTotal = document.getElementById('cartTotal');
  const message = document.getElementById('checkoutMessage');
  const cartCount = document.getElementById('cartCount');

  if (cartItems) {
    cartItems.innerHTML = '';
    const emptyMessage = document.createElement('p');
    emptyMessage.textContent = 'Your cart is empty. Add some coffee! ☕';
    cartItems.appendChild(emptyMessage);
  }

  if (cartTotal) {
    cartTotal.textContent = '₹0';
  }

  if (message) {
    message.textContent = 'Your cart has been cleared!';
    message.style.color = '#4b2e2e';
  }

  if (cartCount) {
    cartCount.textContent = '0';
  }
}

export function proceedToCheckout() {
  const cart = getCart();
  const message = document.getElementById('checkoutMessage');

  if (cart.length === 0) {
    if (message) {
      message.textContent = '☕ Your cart is empty! Please add a product before checkout.';
    }
    return;
  }

  window.location.href = 'order.html';
}
